---
import ReviewStars from './ReviewStars.astro';
import ReviewHighlights from './ReviewHighlights.astro';
import SentimentBadge from './SentimentBadge.astro';
import config from '~/config';
import citiesJson from '~/data/cities.json';
import { getListingsForCity } from '~/lib/listings';
import type { Sentiment } from '~/lib/listings';

interface Props {
  listing: {
    slug: string;
    name: string;
    city: string;
    state: string;
    address: string;
    lat: number;
    lng: number;
    phone?: string;
    website?: string;
    email?: string;
    rating: number;
    review_count: number;
    description?: string;
    certifications?: string[];
    services?: string[];
    years_experience?: number;
    claimed: boolean;
    featured: boolean;
    sentiment?: Sentiment | null;
    demo_reel_url?: string;
  };
}

const { listing } = Astro.props;
const cityData = citiesJson.find((c: any) => c.slug === listing.city);
const cityDisplay = cityData?.city || listing.city;
const stateDisplay = listing.state;

// Initials
const words = listing.name.trim().split(/\s+/).filter((w: string) => w.length > 0);
const initials = words.length >= 2
  ? (words[0][0] + words[1][0]).toUpperCase()
  : listing.name.slice(0, 2).toUpperCase();

// Competitors in same city (for unclaimed FOMO)
const cityListings = getListingsForCity(listing.city);
const competitors = cityListings
  .filter(l => l.slug !== listing.slug && (l.claimed || l.featured || l.review_count > 0))
  .slice(0, 3);

// Completeness score
const completenessItems = [
  { label: 'Business name & location', done: true },
  { label: 'Business description', done: !!listing.description },
  { label: 'Photos & portfolio', done: false },
  { label: 'Certifications (CLVS, NCRA)', done: !!(listing.certifications && listing.certifications.length > 0) },
  { label: 'Service area & availability', done: !!(listing.services && listing.services.length > 0) },
  { label: 'Client reviews', done: listing.review_count > 0 },
];
const completedCount = completenessItems.filter(i => i.done).length;
const completenessPercent = Math.round((completedCount / completenessItems.length) * 100);
---

<div class="space-y-4">

  <!-- ===== PROVIDER VIEW: Claim Banner + Completeness + FOMO (hidden by default) ===== -->
  <div id="provider-view" class="hidden space-y-4">

    <!-- Claim Banner -->
    <div class="bg-gradient-to-r from-amber-50 to-yellow-50 border-2 border-amber-400 rounded-2xl p-5 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="w-10 h-10 bg-amber-400 rounded-xl flex items-center justify-center text-lg flex-shrink-0">🏢</div>
      <div class="flex-1">
        <h3 class="font-bold text-amber-900 text-sm">Is this your business?</h3>
        <p class="text-sm text-amber-700 mt-0.5">Claim your free listing to update info, respond to quote requests, and appear higher in results.</p>
      </div>
      <a href={`/provider/login?listing=${listing.slug}`}
        class="bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-semibold no-underline hover:bg-gray-800 transition-colors whitespace-nowrap">
        Claim Listing — Free
      </a>
    </div>

    <!-- Profile Completeness -->
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
      <h3 class="font-bold text-sm mb-3">Profile Completeness — {completenessPercent}%</h3>
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden mb-4">
        <div class={`h-full rounded-full ${completenessPercent <= 40 ? 'bg-red-500' : completenessPercent <= 70 ? 'bg-amber-500' : 'bg-green-500'}`} style={`width: ${completenessPercent}%`}></div>
      </div>
      <div class="space-y-2">
        {completenessItems.map(item => (
          <div class={`flex items-center gap-2.5 text-sm ${item.done ? 'text-green-700' : 'text-gray-400'}`}>
            <span class="text-base">{item.done ? '✅' : '⬜'}</span>
            {item.label}
          </div>
        ))}
      </div>
    </div>

    <!-- FOMO Banner -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl p-5 flex items-center gap-4">
      <span class="text-3xl flex-shrink-0">📊</span>
      <p class="text-sm text-blue-900 leading-relaxed">
        Attorneys are actively searching for deposition videographers in <strong>{cityDisplay}</strong>.
        Quote requests are being sent to other providers in your area.
      </p>
    </div>
  </div>

  <!-- ===== VERIFIED BADGE (shown for organic attorney traffic) ===== -->
  <div id="verified-badge" class="flex items-center gap-2 text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-4 py-2.5">
    <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <span>Last verified: <strong>{new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</strong></span>
  </div>

  <!-- ===== HEADER CARD ===== -->
  <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
    <!-- Cover -->
    {listing.claimed && listing.featured ? (
      <div class="h-40 bg-gradient-to-r from-gray-800 via-blue-600 to-blue-800"></div>
    ) : (
      <div class="h-28 bg-gradient-to-r from-blue-100 to-indigo-100 relative" id="cover-area">
        <div class="absolute inset-3 border-2 border-dashed border-gray-300 rounded-lg flex items-center justify-center text-gray-400 text-sm font-medium provider-only hidden">
          + Add a cover photo
        </div>
      </div>
    )}

    <div class="px-6 pb-6 relative">
      <!-- Avatar -->
      <div class={`w-[72px] h-[72px] rounded-2xl flex items-center justify-center text-2xl font-bold text-white -mt-9 relative z-10 border-[3px] border-white shadow-md ${listing.claimed ? 'bg-blue-600' : 'bg-gray-400'}`}>
        {initials}
      </div>

      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mt-3">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2 flex-wrap">
            {listing.name}
            {listing.claimed ? (
              <span class="inline-flex items-center gap-1 bg-green-50 text-green-700 text-xs font-semibold px-2 py-1 rounded-md">✓ Verified</span>
            ) : (
              <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-400 text-xs font-medium px-2 py-1 rounded-md provider-only hidden">Unverified</span>
            )}
            {listing.featured && (
              <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 text-xs font-semibold px-2 py-1 rounded-md">⭐ Featured</span>
            )}
          </h1>
          <p class="text-gray-500 text-sm mt-1">{cityDisplay}, {stateDisplay}</p>
          <div class="mt-2 flex items-center gap-3">
            {listing.review_count > 0 ? (
              <ReviewStars rating={listing.rating} count={listing.review_count} />
            ) : (
              <span class="text-gray-300 text-sm italic">No reviews yet</span>
            )}
            {listing.sentiment && <SentimentBadge label={listing.sentiment.label} score={listing.sentiment.score} />}
          </div>
        </div>

        <div class="flex gap-2 sm:flex-col sm:items-end">
          {listing.phone && (
            <a href={`tel:${listing.phone}`} class="inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold no-underline hover:bg-blue-700 transition-colors">
              📞 {listing.phone}
            </a>
          )}
          {listing.website && (
            <a href={listing.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white text-gray-700 border border-gray-300 px-4 py-2.5 rounded-xl text-sm font-medium no-underline hover:bg-gray-50 transition-colors">
              Visit Website
            </a>
          )}
        </div>
      </div>

      <!-- Description -->
      {listing.description ? (
        <p class="mt-4 text-sm text-gray-600 leading-relaxed">{listing.description}</p>
      ) : (
        <div class="mt-4 p-4 border-2 border-dashed border-gray-200 rounded-lg provider-only hidden">
          <p class="text-gray-400 text-sm italic">No description added yet. Attorneys see this when evaluating providers — tell them why you're the right choice.</p>
        </div>
      )}

      <!-- Services -->
      {listing.services && listing.services.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {listing.services.map(svc => (
            <span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">{svc}</span>
          ))}
          <span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-50 text-gray-400 border border-dashed border-gray-300 provider-only hidden">+ Add more</span>
        </div>
      )}
    </div>
  </div>

  <!-- ===== BLURRED STATS (provider view only) ===== -->
  <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 provider-only hidden">
    <h2 class="text-base font-bold mb-4 flex items-center gap-2">
      📈 Your Listing Performance
      <span class="text-xs font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded">🔒 Claim to unlock</span>
    </h2>
    <div class="grid grid-cols-3 gap-3">
      <div class="bg-gray-50 rounded-xl p-4 text-center border border-gray-200">
        <div class="text-2xl font-extrabold text-gray-400 blur-sm select-none">24</div>
        <div class="text-xs text-gray-500 font-medium mt-1">Profile Views</div>
      </div>
      <div class="bg-gray-50 rounded-xl p-4 text-center border border-gray-200">
        <div class="text-2xl font-extrabold text-gray-400 blur-sm select-none">8</div>
        <div class="text-xs text-gray-500 font-medium mt-1">Search Appearances</div>
      </div>
      <div class="bg-gray-50 rounded-xl p-4 text-center border border-gray-200">
        <div class="text-2xl font-extrabold text-gray-400 blur-sm select-none">3</div>
        <div class="text-xs text-gray-500 font-medium mt-1">Quote Requests</div>
      </div>
    </div>
  </div>

  <!-- ===== EMPTY SECTIONS (provider view — unclaimed only) ===== -->
  {!listing.claimed && (
    <>
      <!-- Empty Photo Gallery -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-dashed border-gray-300 relative overflow-hidden provider-only hidden" style="padding-bottom: 60px;">
        <h2 class="text-base font-bold mb-3">📷 Photos & Portfolio</h2>
        <div class="grid grid-cols-4 gap-2">
          {[1,2,3,4].map(() => (
            <div class="aspect-square bg-gray-100 rounded-xl border border-dashed border-gray-300 flex items-center justify-center text-gray-300 text-2xl">+</div>
          ))}
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-white pointer-events-none"></div>
        <a href={`/provider/login?listing=${listing.slug}`}
          class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-semibold no-underline shadow-lg">
          Claim to Add Photos
        </a>
      </div>

      <!-- Empty About -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-dashed border-gray-300 relative overflow-hidden provider-only hidden" style="padding-bottom: 60px;">
        <h2 class="text-base font-bold mb-3">📋 About {listing.name}</h2>
        <div class="space-y-2.5">
          <div class="h-3 bg-gray-100 rounded-full" style="width:90%"></div>
          <div class="h-3 bg-gray-100 rounded-full" style="width:80%"></div>
          <div class="h-3 bg-gray-100 rounded-full" style="width:60%"></div>
          <div class="h-3 bg-gray-100 rounded-full" style="width:90%"></div>
          <div class="h-3 bg-gray-100 rounded-full" style="width:40%"></div>
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-white pointer-events-none"></div>
        <a href={`/provider/login?listing=${listing.slug}`}
          class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-semibold no-underline shadow-lg">
          Claim to Add Details
        </a>
      </div>

      <!-- Empty Reviews -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-dashed border-gray-300 relative overflow-hidden provider-only hidden" style="padding-bottom: 60px;">
        <h2 class="text-base font-bold mb-3">⭐ Client Reviews</h2>
        <div class="space-y-2.5">
          <div class="h-3 bg-gray-100 rounded-full" style="width:80%"></div>
          <div class="h-3 bg-gray-100 rounded-full" style="width:60%"></div>
          <div class="h-6"></div>
          <div class="h-3 bg-gray-100 rounded-full" style="width:90%"></div>
          <div class="h-3 bg-gray-100 rounded-full" style="width:40%"></div>
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-white pointer-events-none"></div>
        <a href={`/provider/login?listing=${listing.slug}`}
          class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-semibold no-underline shadow-lg">
          Claim to Collect Reviews
        </a>
      </div>
    </>
  )}

  <!-- ===== REAL CONTENT SECTIONS ===== -->

  <!-- Certifications + Experience -->
  {(listing.certifications?.length || listing.years_experience) && (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {listing.certifications && listing.certifications.length > 0 && (
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <h3 class="font-semibold text-xs text-gray-500 uppercase tracking-wide mb-2">Certifications</h3>
          <div class="flex flex-wrap gap-1.5">
            {listing.certifications.map(cert => (
              <span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-medium bg-green-100 text-green-800">{cert}</span>
            ))}
          </div>
        </div>
      )}
      {listing.years_experience && (
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <h3 class="font-semibold text-xs text-gray-500 uppercase tracking-wide mb-2">Experience</h3>
          <p class="text-2xl font-bold text-gray-900">{listing.years_experience}+ years</p>
        </div>
      )}
    </div>
  )}

  <!-- Sentiment & Review Highlights -->
  {listing.sentiment && (
    <ReviewHighlights
      label={listing.sentiment.label}
      score={listing.sentiment.score}
      keywords={listing.sentiment.keywords}
      highlights={listing.sentiment.highlights}
      summary={listing.sentiment.summary}
    />
  )}

  <!-- Competitor Peek (provider view only, unclaimed) -->
  {!listing.claimed && competitors.length > 0 && (
    <div class="bg-white rounded-2xl p-5 shadow-sm border-l-4 border-amber-400 provider-only hidden">
      <h3 class="text-sm font-bold text-amber-900 mb-3">⚡ Other providers in {cityDisplay} attorneys are viewing</h3>
      {competitors.map(comp => {
        const compWords = comp.name.split(/\s+/);
        const compInitials = compWords.length >= 2 ? (compWords[0][0] + compWords[1][0]).toUpperCase() : comp.name.slice(0,2).toUpperCase();
        return (
          <div class="flex items-center gap-3 py-2 border-b border-gray-100 last:border-0">
            <div class={`w-9 h-9 rounded-xl flex items-center justify-center text-xs font-bold text-white ${comp.featured ? 'bg-blue-600' : comp.claimed ? 'bg-green-600' : 'bg-gray-400'}`}>
              {compInitials}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold truncate">{comp.name}</p>
              <p class="text-xs text-gray-400">
                {comp.review_count > 0 ? `★ ${comp.rating} · ${comp.review_count} reviews` : 'No reviews'}
                {comp.claimed ? ' · Claimed' : ''}
              </p>
            </div>
            {comp.featured && (
              <span class="text-[11px] font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded">Featured</span>
            )}
          </div>
        );
      })}
    </div>
  )}

  <!-- Recent Activity (provider view only) -->
  <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 provider-only hidden">
    <h2 class="text-base font-bold mb-3">🕐 Recent Activity in {cityDisplay}</h2>
    <div class="space-y-0">
      <div class="flex items-center gap-3 py-2.5 border-b border-gray-100 text-sm text-gray-600">
        <span class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></span>
        Attorney requested a quote from a {cityDisplay} provider
        <span class="ml-auto text-xs text-gray-400 whitespace-nowrap">2 hours ago</span>
      </div>
      <div class="flex items-center gap-3 py-2.5 border-b border-gray-100 text-sm text-gray-600">
        <span class="w-2 h-2 rounded-full bg-blue-500 flex-shrink-0"></span>
        New search: "deposition videographer {cityDisplay}"
        <span class="ml-auto text-xs text-gray-400 whitespace-nowrap">5 hours ago</span>
      </div>
      <div class="flex items-center gap-3 py-2.5 border-b border-gray-100 text-sm text-gray-600">
        <span class="w-2 h-2 rounded-full bg-amber-500 flex-shrink-0"></span>
        A provider updated their featured listing
        <span class="ml-auto text-xs text-gray-400 whitespace-nowrap">1 day ago</span>
      </div>
      <div class="flex items-center gap-3 py-2.5 text-sm text-gray-600">
        <span class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></span>
        2 quote requests sent to {cityDisplay} providers
        <span class="ml-auto text-xs text-gray-400 whitespace-nowrap">2 days ago</span>
      </div>
    </div>
  </div>

  <!-- Map -->
  <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
    <div class="p-5 pb-0">
      <h2 class="text-base font-bold mb-1">📍 Location</h2>
      <p class="text-sm text-gray-500 mb-3">{listing.address || `${cityDisplay}, ${stateDisplay}`}</p>
    </div>
    <div id="listing-map" class="h-56 w-full" data-lat={listing.lat} data-lng={listing.lng} data-name={listing.name}></div>
  </div>

  <!-- Upgrade CTA (provider view only) -->
  {!listing.claimed && (
    <div class="bg-gradient-to-br from-gray-900 to-indigo-900 rounded-2xl p-8 text-center text-white provider-only hidden">
      <h2 class="text-xl font-bold mb-2">🚀 Get Featured in {cityDisplay}</h2>
      <p class="text-indigo-200 text-sm mb-6">Appear above every other provider. Only 2 Featured spots available per city.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left max-w-md mx-auto mb-6">
        <div class="flex items-start gap-2 text-sm text-indigo-200"><span class="text-green-400">✓</span> Pinned to #1 in {cityDisplay}</div>
        <div class="flex items-start gap-2 text-sm text-indigo-200"><span class="text-green-400">✓</span> "Featured" badge</div>
        <div class="flex items-start gap-2 text-sm text-indigo-200"><span class="text-green-400">✓</span> Quotes to your inbox</div>
        <div class="flex items-start gap-2 text-sm text-indigo-200"><span class="text-green-400">✓</span> Monthly impressions report</div>
        <div class="flex items-start gap-2 text-sm text-indigo-200"><span class="text-green-400">✓</span> Priority in searches</div>
        <div class="flex items-start gap-2 text-sm text-indigo-200"><span class="text-green-400">✓</span> Verified badge</div>
      </div>
      <a href="https://buy.stripe.com/4gM14m8rggWc0yU5Ada3u01" target="_blank" rel="noopener"
        class="inline-block bg-amber-400 text-gray-900 px-8 py-3.5 rounded-xl text-base font-bold no-underline hover:bg-amber-300 transition-colors">
        Get Featured — $79/mo
      </a>
      <p class="text-xs text-indigo-300 mt-3">No contracts · No setup fees · Cancel anytime</p>
    </div>
  )}
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
  function initListingPage() {
    // Map
    const el = document.getElementById('listing-map');
    if (el && !el.dataset.init) {
      el.dataset.init = 'true';
      const lat = parseFloat(el.dataset.lat);
      const lng = parseFloat(el.dataset.lng);
      const name = el.dataset.name;
      const map = L.map(el).setView([lat, lng], 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);
      L.marker([lat, lng]).addTo(map).bindPopup(name).openPopup();
    }

    // Provider view toggle
    const params = new URLSearchParams(window.location.search);
    const isProvider = params.get('claim') === 'true' || params.get('src') === 'provider';

    if (isProvider) {
      document.querySelectorAll('.provider-only').forEach(function(el) { el.classList.remove('hidden'); });
      var providerView = document.getElementById('provider-view');
      if (providerView) providerView.classList.remove('hidden');
      var badge = document.getElementById('verified-badge');
      if (badge) badge.classList.add('hidden');
    }

    // Live-patch claimed listing data from D1
    var slug = window.location.pathname.replace(/^\/listing\//, '').replace(/\/$/, '');
    if (slug) {
      fetch('/api/listing/' + slug)
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.claimed) return;
          var data = d.data || {};

          // Patch description
          if (data.description) {
            var descEl = document.querySelector('[data-pagefind-body] .text-sm.text-gray-600.leading-relaxed');
            if (descEl) descEl.textContent = data.description;
          }

          // Patch phone
          if (data.phone) {
            var phoneEl = document.querySelector('a[href^="tel:"]');
            if (phoneEl) { phoneEl.href = 'tel:' + data.phone; phoneEl.innerHTML = '&#x1F4DE; ' + data.phone; }
          }

          // Patch website
          if (data.website) {
            var siteEl = document.querySelector('a[target="_blank"][rel="noopener noreferrer"]');
            if (siteEl) { siteEl.href = data.website; }
          }

          // Patch services
          if (data.services && data.services.length > 0) {
            var svcWrap = document.querySelector('.flex.flex-wrap.gap-2.mt-4');
            if (svcWrap) {
              svcWrap.innerHTML = data.services.map(function(s) {
                return '<span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">' + s + '</span>';
              }).join('');
            }
          }

          // Patch certifications
          if (data.certifications && data.certifications.length > 0) {
            var certWrap = document.querySelector('.flex.flex-wrap.gap-1\\.5');
            if (certWrap) {
              certWrap.innerHTML = data.certifications.map(function(c) {
                return '<span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-medium bg-green-100 text-green-800">' + c + '</span>';
              }).join('');
            }
          }

          // Show verified badge for claimed listings
          if (!isProvider) {
            var vBadge = document.getElementById('verified-badge');
            if (vBadge) {
              vBadge.querySelector('span').innerHTML = 'Claimed &amp; verified by owner';
              vBadge.classList.remove('hidden');
            }
          }

          // Render photos if available
          if (d.photos && d.photos.length > 0) {
            var mapSection = document.querySelector('#listing-map')?.closest('.bg-white');
            if (mapSection) {
              var photoHtml = '<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">' +
                '<h2 class="text-base font-bold mb-3">Photos</h2>' +
                '<div class="grid grid-cols-2 sm:grid-cols-3 gap-2">' +
                d.photos.map(function(p) {
                  return '<img src="' + p.url + '" alt="' + (p.filename || 'Photo') + '" class="rounded-xl w-full aspect-[4/3] object-cover" loading="lazy" />';
                }).join('') +
                '</div></div>';
              mapSection.insertAdjacentHTML('beforebegin', photoHtml);
            }
          }
        })
        .catch(function() {});
    }
  }

  document.addEventListener('astro:page-load', initListingPage);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initListingPage);
  } else {
    initListingPage();
  }
</script>
