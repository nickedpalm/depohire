---
interface Props {
  listingName: string;
  listingEmail?: string;
  listingSlug?: string;
  city?: string;
}

const { listingName, listingEmail, listingSlug = '', city = '' } = Astro.props;
const API_URL = 'https://api.depohire.com/api/leads';
---
<div class="card p-6" id="contact-form-card">
  <h3 class="text-lg font-semibold text-gray-900 mb-4">Request a Quote from {listingName}</h3>
  <form id="quote-form" class="space-y-4" data-api-url={API_URL}>
    <input type="hidden" name="provider_name" value={listingName} />
    <input type="hidden" name="provider_email" value={listingEmail || ''} />
    <input type="hidden" name="provider_slug" value={listingSlug} />
    <input type="hidden" name="city" value={city} />
    <!-- Honeypot -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
    </div>
    <div>
      <label for="attorney_name" class="block text-sm font-medium text-gray-700">Your Name</label>
      <input type="text" id="attorney_name" name="attorney_name" required class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-3 py-2 border" />
    </div>
    <div>
      <label for="attorney_email" class="block text-sm font-medium text-gray-700">Email</label>
      <input type="email" id="attorney_email" name="attorney_email" required class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-3 py-2 border" />
    </div>
    <div>
      <label for="attorney_phone" class="block text-sm font-medium text-gray-700">Phone <span class="text-gray-400">(optional)</span></label>
      <input type="tel" id="attorney_phone" name="attorney_phone" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-3 py-2 border" />
    </div>
    <div>
      <label for="case_details" class="block text-sm font-medium text-gray-700">Case Details</label>
      <textarea id="case_details" name="case_details" rows="3" placeholder="Date, location, type of proceeding..." class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 px-3 py-2 border"></textarea>
    </div>
    <button type="submit" class="btn-primary w-full justify-center" id="quote-submit-btn">
      Send Request
    </button>
    <p class="text-xs text-gray-400 text-center">Your request is sent directly to {listingName}. Free, no obligation.</p>
  </form>

  <!-- Success state -->
  <div id="quote-success" class="hidden text-center py-6">
    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3">
      <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h3 class="text-lg font-semibold text-gray-900">Quote Request Sent!</h3>
    <p class="text-sm text-gray-600 mt-1">Your request has been sent to {listingName}. They'll respond directly to your email, usually within 1 business day.</p>
  </div>

  <!-- Error state -->
  <div id="quote-error" class="hidden bg-red-50 border border-red-200 rounded-lg p-3 mt-3">
    <p class="text-sm text-red-700" id="quote-error-msg">Something went wrong. Please try again.</p>
  </div>
</div>

<script is:inline>
  function initContactForm() {
    const form = document.getElementById('quote-form');
    if (!form || form.dataset.init) return;
    form.dataset.init = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('quote-submit-btn');
      const errorDiv = document.getElementById('quote-error');
      const successDiv = document.getElementById('quote-success');
      errorDiv.classList.add('hidden');

      btn.disabled = true;
      btn.textContent = 'Sending...';

      const data = {
        attorney_name: form.attorney_name.value,
        attorney_email: form.attorney_email.value,
        attorney_phone: form.attorney_phone.value,
        case_details: form.case_details.value,
        city: form.city.value,
        honeypot: form.company_url.value,
        providers: [{
          name: form.provider_name.value,
          email: form.provider_email.value,
          slug: form.provider_slug.value,
        }],
      };

      try {
        const resp = await fetch(form.dataset.apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!resp.ok) {
          const err = await resp.json().catch(() => ({}));
          throw new Error(err.detail || 'Request failed');
        }
        form.classList.add('hidden');
        successDiv.classList.remove('hidden');
      } catch (err) {
        document.getElementById('quote-error-msg').textContent = err.message || 'Something went wrong. Please try again.';
        errorDiv.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Send Request';
      }
    });
  }
  document.addEventListener('astro:page-load', initContactForm);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>
