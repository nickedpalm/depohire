---
import PageLayout from '~/layouts/PageLayout.astro';
const metadata = { title: 'Provider Dashboard — DepoHire', description: 'Manage your DepoHire listing.' };
---
<PageLayout metadata={metadata}>
  <Fragment slot="announcement"><span></span></Fragment>

  <!-- Loading state -->
  <div id="loading" class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <div class="w-8 h-8 border-4 border-primary-200 border-t-primary-600 rounded-full animate-spin mx-auto mb-4"></div>
      <p class="text-sm text-gray-500">Loading your dashboard...</p>
    </div>
  </div>

  <!-- Dashboard (hidden until loaded) -->
  <div id="dashboard" class="hidden">
    <!-- Header -->
    <div class="border-b border-gray-200 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <div>
          <h1 class="text-lg font-bold text-gray-900">Provider Dashboard</h1>
          <p id="provider-email" class="text-sm text-gray-500"></p>
        </div>
        <button id="logout-btn" class="text-sm text-gray-500 hover:text-red-600 transition-colors font-medium">Log out</button>
      </div>
    </div>

    <!-- Tabs -->
    <div class="border-b border-gray-200 bg-white sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <nav class="flex gap-6 -mb-px" id="tabs">
          <button data-tab="listing" class="tab-btn py-3 text-sm font-medium border-b-2 border-primary-600 text-primary-700">Listing</button>
          <button data-tab="leads" class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">Leads</button>
          <button data-tab="settings" class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">Settings</button>
        </nav>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">

      <!-- ===== LISTING TAB ===== -->
      <div id="tab-listing" class="tab-content space-y-6">

        <!-- Save status banner -->
        <div id="save-banner" class="hidden bg-green-50 border border-green-200 text-green-800 text-sm font-medium px-4 py-3 rounded-xl text-center"></div>

        <!-- Business Info -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
          <h2 class="text-base font-bold text-gray-900 mb-4">Business Information</h2>
          <form id="listing-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Business Name</label>
                <input type="text" name="name" class="dash-input" placeholder="Your business name" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                <input type="tel" name="phone" class="dash-input" placeholder="(555) 123-4567" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Website</label>
                <input type="url" name="website" class="dash-input" placeholder="https://yoursite.com" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Contact Email</label>
                <input type="email" name="email" class="dash-input" placeholder="contact@yoursite.com" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
              <textarea name="description" rows="4" class="dash-input" placeholder="Tell attorneys why they should hire you. Mention your experience, equipment, and specialties."></textarea>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Coverage Area</label>
                <input type="text" name="coverage_area" class="dash-input" placeholder="e.g., Greater San Diego metro" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Years of Experience</label>
                <input type="number" name="years_experience" class="dash-input" placeholder="e.g., 15" min="0" max="99" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Demo Reel URL</label>
              <input type="url" name="demo_reel_url" class="dash-input" placeholder="https://youtube.com/watch?v=..." />
            </div>

            <!-- Services -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Services</label>
              <div id="services-list" class="flex flex-wrap gap-2 mb-2"></div>
              <div class="flex gap-2">
                <input type="text" id="new-service" class="dash-input flex-1" placeholder="Add a service (e.g., Deposition Video)" />
                <button type="button" id="add-service-btn" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-xl text-sm font-medium text-gray-700 transition-colors">Add</button>
              </div>
            </div>

            <!-- Certifications -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Certifications</label>
              <div id="certs-list" class="flex flex-wrap gap-2 mb-2"></div>
              <div class="flex gap-2">
                <input type="text" id="new-cert" class="dash-input flex-1" placeholder="Add certification (e.g., CLVS)" />
                <button type="button" id="add-cert-btn" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-xl text-sm font-medium text-gray-700 transition-colors">Add</button>
              </div>
            </div>

            <div class="pt-2">
              <button type="submit" id="save-btn" class="bg-primary-600 hover:bg-primary-500 text-white font-semibold px-8 py-3 rounded-xl transition-colors text-sm">
                Save Changes
              </button>
            </div>
          </form>
        </div>

        <!-- Photos (placeholder) -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
          <h2 class="text-base font-bold text-gray-900 mb-2">Photos</h2>
          <p class="text-sm text-gray-500 mb-4">Upload photos of your setup, equipment, or past work.</p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="photos-grid">
            <div class="aspect-square bg-gray-50 rounded-xl border-2 border-dashed border-gray-300 flex flex-col items-center justify-center text-gray-400 cursor-pointer hover:border-primary-300 hover:text-primary-400 transition-colors">
              <svg class="w-8 h-8 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/></svg>
              <span class="text-xs font-medium">Add Photo</span>
            </div>
          </div>
          <p class="text-xs text-gray-400 mt-3">Photo uploads coming soon. Contact us to add photos manually.</p>
        </div>

        <!-- Upgrade CTA -->
        <div class="bg-gradient-to-br from-gray-900 to-indigo-900 rounded-2xl p-8 text-center text-white">
          <h2 class="text-xl font-bold mb-2">Get Featured</h2>
          <p class="text-indigo-200 text-sm mb-4">Appear at the top of search results in your city. Only 2 Featured spots per city.</p>
          <div class="flex flex-wrap justify-center gap-3 text-sm text-indigo-200 mb-6">
            <span>Pinned to #1</span>
            <span class="text-indigo-500">&middot;</span>
            <span>Featured badge</span>
            <span class="text-indigo-500">&middot;</span>
            <span>Priority leads</span>
            <span class="text-indigo-500">&middot;</span>
            <span>Monthly report</span>
          </div>
          <a href="https://buy.stripe.com/4gM14m8rggWc0yU5Ada3u01" target="_blank" rel="noopener"
            class="inline-block bg-amber-400 text-gray-900 px-8 py-3.5 rounded-xl text-base font-bold no-underline hover:bg-amber-300 transition-colors">
            Get Featured — $79/mo
          </a>
          <p class="text-xs text-indigo-300 mt-3">No contracts &middot; Cancel anytime</p>
        </div>

        <!-- View Public Listing -->
        <div class="text-center">
          <a id="public-link" href="#" target="_blank" class="text-sm text-primary-600 hover:text-primary-700 font-medium">
            View your public listing &rarr;
          </a>
        </div>
      </div>

      <!-- ===== LEADS TAB ===== -->
      <div id="tab-leads" class="tab-content hidden space-y-4">
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
          <h2 class="text-base font-bold text-gray-900 mb-4">Quote Requests</h2>
          <div id="leads-list">
            <p class="text-sm text-gray-400 text-center py-8">Loading leads...</p>
          </div>
        </div>
      </div>

      <!-- ===== SETTINGS TAB ===== -->
      <div id="tab-settings" class="tab-content hidden space-y-6">
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
          <h2 class="text-base font-bold text-gray-900 mb-4">Account Settings</h2>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
              <p id="settings-email" class="text-sm text-gray-600 bg-gray-50 px-4 py-3 rounded-xl"></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Claimed Listings</label>
              <div id="settings-listings" class="text-sm text-gray-600"></div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
          <h2 class="text-base font-bold text-gray-900 mb-2">Billing</h2>
          <p class="text-sm text-gray-500 mb-4">Manage your subscription and payment methods.</p>
          <a href="https://billing.stripe.com/p/login/test_placeholder" target="_blank" rel="noopener"
            class="inline-flex items-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
            Manage Billing
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <div class="bg-red-50 rounded-2xl border border-red-200 p-6">
          <h2 class="text-base font-bold text-red-900 mb-2">Danger Zone</h2>
          <p class="text-sm text-red-700 mb-4">Need to remove your listing or delete your account? Contact us.</p>
          <a href="mailto:contact@depohire.com?subject=Account removal request" class="text-sm text-red-600 font-medium hover:underline">
            Contact support
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
    .dash-input {
      width: 100%;
      padding: 0.625rem 1rem;
      border-radius: 0.75rem;
      border: 1px solid #d1d5db;
      font-size: 0.875rem;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .dash-input:focus {
      outline: none;
      border-color: #93c5fd;
      box-shadow: 0 0 0 3px rgba(147, 197, 253, 0.3);
    }
    .tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.75rem;
      font-weight: 500;
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
    }
    .tag-pill button {
      color: #93c5fd;
      font-size: 14px;
      line-height: 1;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
    }
    .tag-pill button:hover { color: #ef4444; }
  </style>

  <script is:inline>
    (function() {
      var state = {
        provider: null,
        listings: [],
        currentSlug: null,
        listingData: {},
        services: [],
        certifications: [],
      };

      // --- Auth Check ---
      async function checkAuth() {
        try {
          var resp = await fetch('/api/auth/session', { credentials: 'include' });
          var data = await resp.json();
          if (!data.authenticated) {
            window.location.href = '/provider/login';
            return;
          }
          state.provider = data.provider;
          state.listings = data.listings || [];

          var params = new URLSearchParams(window.location.search);
          state.currentSlug = params.get('listing') || state.listings[0] || null;

          renderDashboard();
          if (state.currentSlug) {
            loadListing();
          }
        } catch (err) {
          window.location.href = '/provider/login';
        }
      }

      function renderDashboard() {
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('dashboard').classList.remove('hidden');
        document.getElementById('provider-email').textContent = state.provider.email;
        document.getElementById('settings-email').textContent = state.provider.email;

        if (state.currentSlug) {
          document.getElementById('public-link').href = '/listing/' + state.currentSlug + '/';
        }

        var listingsEl = document.getElementById('settings-listings');
        if (state.listings.length === 0) {
          listingsEl.innerHTML = '<p class="text-gray-400">No claimed listings yet.</p>';
        } else {
          listingsEl.innerHTML = state.listings.map(function(s) {
            return '<a href="/provider/dashboard?listing=' + s + '" class="block bg-gray-50 px-4 py-3 rounded-xl mb-2 hover:bg-gray-100">' + s + '</a>';
          }).join('');
        }
      }

      // --- Load Listing Data ---
      async function loadListing() {
        if (!state.currentSlug) return;
        try {
          var resp = await fetch('/api/provider/listing?slug=' + state.currentSlug, { credentials: 'include' });
          if (!resp.ok) return;
          var result = await resp.json();
          state.listingData = result.data || {};
          populateForm();
        } catch (err) {
          console.error('Failed to load listing:', err);
        }
      }

      function populateForm() {
        var form = document.getElementById('listing-form');
        var d = state.listingData;
        var fields = ['name', 'phone', 'website', 'email', 'description', 'coverage_area', 'years_experience', 'demo_reel_url'];
        fields.forEach(function(f) {
          var el = form.querySelector('[name="' + f + '"]');
          if (el && d[f] !== undefined && d[f] !== null) el.value = d[f];
        });

        state.services = Array.isArray(d.services) ? d.services.slice() : [];
        state.certifications = Array.isArray(d.certifications) ? d.certifications.slice() : [];
        renderTags('services-list', state.services, 'service');
        renderTags('certs-list', state.certifications, 'cert');
      }

      // --- Tag Management ---
      function renderTags(containerId, items, type) {
        var container = document.getElementById(containerId);
        container.innerHTML = items.map(function(item, i) {
          return '<span class="tag-pill">' + escapeHtml(item) + '<button data-type="' + type + '" data-index="' + i + '">&times;</button></span>';
        }).join('');
      }

      function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.tag-pill button');
        if (!btn) return;
        var type = btn.dataset.type;
        var index = parseInt(btn.dataset.index);
        if (type === 'service') {
          state.services.splice(index, 1);
          renderTags('services-list', state.services, 'service');
        } else if (type === 'cert') {
          state.certifications.splice(index, 1);
          renderTags('certs-list', state.certifications, 'cert');
        }
      });

      document.getElementById('add-service-btn').addEventListener('click', function() {
        var input = document.getElementById('new-service');
        var val = input.value.trim();
        if (val && state.services.indexOf(val) === -1) {
          state.services.push(val);
          renderTags('services-list', state.services, 'service');
          input.value = '';
        }
      });

      document.getElementById('add-cert-btn').addEventListener('click', function() {
        var input = document.getElementById('new-cert');
        var val = input.value.trim();
        if (val && state.certifications.indexOf(val) === -1) {
          state.certifications.push(val);
          renderTags('certs-list', state.certifications, 'cert');
          input.value = '';
        }
      });

      // Enter key to add tags
      document.getElementById('new-service').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); document.getElementById('add-service-btn').click(); }
      });
      document.getElementById('new-cert').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); document.getElementById('add-cert-btn').click(); }
      });

      // --- Save Listing ---
      document.getElementById('listing-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        var form = e.target;
        var btn = document.getElementById('save-btn');
        var banner = document.getElementById('save-banner');

        btn.textContent = 'Saving...';
        btn.disabled = true;

        var payload = {
          slug: state.currentSlug,
          name: form.querySelector('[name="name"]').value.trim(),
          phone: form.querySelector('[name="phone"]').value.trim(),
          website: form.querySelector('[name="website"]').value.trim(),
          email: form.querySelector('[name="email"]').value.trim(),
          description: form.querySelector('[name="description"]').value.trim(),
          coverage_area: form.querySelector('[name="coverage_area"]').value.trim(),
          years_experience: parseInt(form.querySelector('[name="years_experience"]').value) || null,
          demo_reel_url: form.querySelector('[name="demo_reel_url"]').value.trim(),
          services: state.services,
          certifications: state.certifications,
        };

        try {
          var resp = await fetch('/api/provider/listing', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload),
          });

          if (resp.ok) {
            banner.textContent = 'Changes saved successfully.';
            banner.className = 'bg-green-50 border border-green-200 text-green-800 text-sm font-medium px-4 py-3 rounded-xl text-center';
            banner.classList.remove('hidden');
            state.listingData = (await resp.json()).data;
            setTimeout(function() { banner.classList.add('hidden'); }, 3000);
          } else {
            var err = await resp.json();
            banner.textContent = err.error || 'Failed to save.';
            banner.className = 'bg-red-50 border border-red-200 text-red-700 text-sm font-medium px-4 py-3 rounded-xl text-center';
            banner.classList.remove('hidden');
          }
        } catch (err) {
          banner.textContent = 'Network error. Please try again.';
          banner.className = 'bg-red-50 border border-red-200 text-red-700 text-sm font-medium px-4 py-3 rounded-xl text-center';
          banner.classList.remove('hidden');
        } finally {
          btn.textContent = 'Save Changes';
          btn.disabled = false;
        }
      });

      // --- Leads Tab ---
      async function loadLeads() {
        if (!state.currentSlug) return;
        var container = document.getElementById('leads-list');
        try {
          var resp = await fetch('/api/provider/leads?slug=' + state.currentSlug, { credentials: 'include' });
          var data = await resp.json();
          var leads = data.leads || [];

          if (leads.length === 0) {
            container.innerHTML = '<div class="text-center py-12"><p class="text-gray-400 text-sm">No quote requests yet.</p><p class="text-gray-400 text-xs mt-1">When attorneys request a quote through your listing, it will appear here.</p></div>';
            return;
          }

          container.innerHTML = leads.map(function(lead) {
            var date = new Date(lead.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            return '<div class="border-b border-gray-100 last:border-0 py-4">' +
              '<div class="flex items-start justify-between gap-4">' +
                '<div class="min-w-0">' +
                  '<p class="font-semibold text-sm text-gray-900">' + escapeHtml(lead.attorney_name || 'Anonymous') + '</p>' +
                  '<p class="text-xs text-gray-500 mt-0.5">' + escapeHtml(lead.city || '') + ' &middot; ' + date + '</p>' +
                  (lead.case_details ? '<p class="text-sm text-gray-600 mt-2">' + escapeHtml(lead.case_details) + '</p>' : '') +
                '</div>' +
                (lead.attorney_email ? '<a href="mailto:' + encodeURIComponent(lead.attorney_email) + '" class="flex-shrink-0 bg-primary-600 text-white px-4 py-2 rounded-lg text-xs font-semibold no-underline hover:bg-primary-500">Reply</a>' : '') +
              '</div>' +
            '</div>';
          }).join('');
        } catch (err) {
          container.innerHTML = '<p class="text-sm text-red-500 text-center py-8">Failed to load leads.</p>';
        }
      }

      // --- Tabs ---
      document.getElementById('tabs').addEventListener('click', function(e) {
        var btn = e.target.closest('.tab-btn');
        if (!btn) return;
        var tab = btn.dataset.tab;

        document.querySelectorAll('.tab-btn').forEach(function(b) {
          b.classList.remove('border-primary-600', 'text-primary-700');
          b.classList.add('border-transparent', 'text-gray-500');
        });
        btn.classList.remove('border-transparent', 'text-gray-500');
        btn.classList.add('border-primary-600', 'text-primary-700');

        document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.add('hidden'); });
        document.getElementById('tab-' + tab).classList.remove('hidden');

        if (tab === 'leads') loadLeads();
      });

      // --- Logout ---
      document.getElementById('logout-btn').addEventListener('click', async function() {
        await fetch('/api/auth/session', { method: 'DELETE', credentials: 'include' });
        window.location.href = '/provider/login';
      });

      // --- Init ---
      checkAuth();
    })();
  </script>
</PageLayout>
