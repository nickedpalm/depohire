---
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/directory/Breadcrumbs.astro';
import AuthorBox from '~/components/directory/AuthorBox.astro';
import RelatedContent from '~/components/directory/RelatedContent.astro';
import config from '~/config';
import citiesData from '~/data/cities.json';
import { getListingCountByCity } from '~/lib/listings';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, author = config.editorialAuthor.name, tags = [], hub, image: heroImage, imageCredit } = post.data;

// Resolve hub title to actual post slug for breadcrumb link
let hubHref: string | undefined;
if (hub) {
  const allPosts = await getCollection('blog');
  const hubPost = allPosts.find(p => p.data.title === hub);
  hubHref = hubPost ? `/blog/${hubPost.id}/` : undefined;
}

const formattedDate = pubDate ? pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
const body = post.body || '';
const wordCount = body.split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate?.toISOString(),
  dateModified: new Date().toISOString(),
  author: {
    '@type': 'Person',
    name: config.editorialAuthor.name,
    jobTitle: config.editorialAuthor.title,
    ...(config.editorialAuthor.linkedin ? { sameAs: [config.editorialAuthor.linkedin] } : {}),
    knowsAbout: [config.primaryKeyword, config.industry, ...config.secondaryKeywords.slice(0, 3)],
  },
  publisher: {
    '@type': 'Organization',
    name: config.name,
    url: config.siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${config.siteUrl}/blog/`,
  },
};

const metadata = { title, description };

// Top cities for internal linking CTA
const cityCounts = getListingCountByCity();
const allCitiesWithCount = citiesData
  .map(c => ({ ...c, count: cityCounts[c.slug] || 0 }))
  .filter(c => c.count > 0)
  .sort((a, b) => b.count - a.count);
const topCities = allCitiesWithCount.slice(0, 6);
---
<PageLayout metadata={metadata}>
  <Fragment slot="announcement"><span></span></Fragment>
  <section class="py-8 sm:py-16 lg:py-20 mx-auto">
    <article>
      <header class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div class="max-w-3xl mx-auto px-4 sm:px-6">
          <Breadcrumbs crumbs={[
            { label: 'Blog', href: '/blog/' },
            ...(hub && hubHref ? [{ label: hub, href: hubHref }] : []),
            { label: title },
          ]} />
        </div>

        <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
          <p class="text-sm text-muted">
            <svg class="w-4 h-4 inline-block -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <time datetime={pubDate?.toISOString()}>{formattedDate}</time>
            {' '}&middot;{' '}
            <svg class="w-4 h-4 inline-block -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            <a href="/about/" class="hover:underline inline-block">{author}</a>
            {' '}&middot; <span>{readingTime} min read</span>
          </p>
        </div>

        <h1 class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
          {title}
        </h1>

        <p class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted">
          {description}
        </p>

        {tags.length > 0 && (
          <div class="max-w-3xl mx-auto px-4 sm:px-6 mb-6">
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">{tag}</span>
              ))}
            </div>
          </div>
        )}

        <div class="max-w-3xl mx-auto px-4 sm:px-6">
          {heroImage ? (
            <div class="relative rounded-xl overflow-hidden">
              <img
                src={heroImage}
                alt={title}
                class="w-full h-48 sm:h-64 md:h-80 object-cover"
                loading="eager"
                decoding="async"
              />
              {imageCredit && (
                <p class="absolute bottom-2 right-3 text-[10px] text-white/80 bg-black/40 px-2 py-0.5 rounded" set:html={imageCredit.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="underline hover:text-white" target="_blank" rel="noopener noreferrer">$1</a>')} />
              )}
            </div>
          ) : (
            <div class="border-t border-gray-200"></div>
          )}
        </div>
      </header>

      <div
        class="mx-auto px-4 sm:px-6 max-w-3xl prose prose-lg lg:prose-xl prose-headings:font-heading prose-headings:font-bold prose-headings:leading-tighter prose-headings:tracking-tighter prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-md prose-img:shadow-lg prose-headings:scroll-mt-[80px] prose-li:my-0 mt-8"
        id="article-content"
      >
        <Content />
      </div>

      <div class="mx-auto px-4 sm:px-6 max-w-3xl">
        {topCities.length > 0 && (
          <div class="bg-blue-50 rounded-xl p-6 mt-8 mb-6">
            <h3 class="text-lg font-bold text-default mb-3">Find a {config.primaryKeyword} Near You</h3>
            <div class="relative mb-3">
              <input
                type="text"
                id="city-search"
                placeholder="City name or zip code..."
                class="w-full px-4 py-2.5 rounded-lg border border-blue-200 bg-white text-sm focus:ring-primary-500 focus:border-primary-500"
                autocomplete="off"
              />
              <div id="city-dropdown" class="absolute top-full left-0 right-0 bg-white border border-gray-200 rounded-lg mt-1 shadow-lg max-h-48 overflow-y-auto hidden z-20"></div>
              <div id="blog-zip-loading" class="hidden mt-1 text-xs text-gray-500">Finding providers near you...</div>
            </div>
            <p class="text-xs text-gray-500 mb-2">Popular cities:</p>
            <div class="flex flex-wrap gap-2">
              {topCities.map(c => (
                <a href={`/locations/${c.stateSlug}/${c.slug}/`} class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium bg-white border border-blue-200 text-primary no-underline hover:bg-blue-100 transition-colors">
                  {c.city} <span class="text-muted ml-1 text-xs">({c.count})</span>
                </a>
              ))}
              <a href="/states/all/" class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium bg-primary text-white no-underline hover:opacity-90 transition-opacity">
                All Cities &rarr;
              </a>
            </div>
            <script type="application/json" id="city-data" set:html={JSON.stringify(allCitiesWithCount.map(c => ({ slug: c.slug, stateSlug: c.stateSlug, city: c.city, state: c.state, lat: c.lat, lng: c.lng, count: c.count })))} />
          </div>
        )}
        <script is:inline>
          function initCitySearch() {
            const input = document.getElementById('city-search');
            const dropdown = document.getElementById('city-dropdown');
            const dataEl = document.getElementById('city-data');
            const loading = document.getElementById('blog-zip-loading');
            if (!input || !dropdown || !dataEl || input.dataset.init) return;
            input.dataset.init = 'true';

            const cities = JSON.parse(dataEl.textContent);

            function haversine(lat1, lng1, lat2, lng2) {
              const R = 3959;
              const dLat = (lat2 - lat1) * Math.PI / 180;
              const dLng = (lng2 - lng1) * Math.PI / 180;
              const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2;
              return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            }

            async function searchZip(zip) {
              loading?.classList.remove('hidden');
              dropdown.classList.add('hidden');
              try {
                const resp = await fetch(`https://api.zippopotam.us/us/${zip}`);
                if (!resp.ok) throw new Error();
                const data = await resp.json();
                const lat = parseFloat(data.places[0].latitude);
                const lng = parseFloat(data.places[0].longitude);
                const nearest = cities
                  .map(c => ({ ...c, distance: haversine(lat, lng, c.lat || 0, c.lng || 0) }))
                  .sort((a, b) => a.distance - b.distance)
                  .slice(0, 6);
                dropdown.innerHTML = `<div class="px-3 py-1.5 text-xs text-gray-400 bg-gray-50 border-b">Nearest to ${zip}</div>` +
                  nearest.map(c =>
                    `<a href="/locations/${c.stateSlug}/${c.slug}/" class="flex justify-between px-4 py-2 text-sm hover:bg-blue-50 no-underline text-gray-700"><span>${c.city}, ${c.state}</span><span class="text-gray-400 text-xs">${Math.round(c.distance)} mi (${c.count})</span></a>`
                  ).join('');
                dropdown.classList.remove('hidden');
              } catch {
                dropdown.innerHTML = '<div class="px-4 py-2 text-sm text-gray-500">Zip not found. Try a city name.</div>';
                dropdown.classList.remove('hidden');
              } finally {
                loading?.classList.add('hidden');
              }
            }

            input.addEventListener('input', () => {
              const q = input.value.trim();
              if (/^\d{5}$/.test(q)) { searchZip(q); return; }
              if (q.length < 2) { dropdown.classList.add('hidden'); return; }

              const matches = cities.filter(c =>
                c.city.toLowerCase().includes(q.toLowerCase()) || c.state.toLowerCase().includes(q.toLowerCase())
              ).slice(0, 8);

              if (matches.length === 0) { dropdown.classList.add('hidden'); return; }

              dropdown.innerHTML = matches.map(c =>
                `<a href="/locations/${c.stateSlug}/${c.slug}/" class="block px-4 py-2 text-sm hover:bg-blue-50 no-underline text-gray-700">${c.city}, ${c.state} <span class="text-gray-400">(${c.count})</span></a>`
              ).join('');
              dropdown.classList.remove('hidden');
            });

            input.addEventListener('blur', () => {
              setTimeout(() => dropdown.classList.add('hidden'), 200);
            });
          }
          document.addEventListener('astro:page-load', initCitySearch);
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCitySearch);
          } else {
            initCitySearch();
          }
        </script>
        <AuthorBox />
        <RelatedContent currentSlug={Astro.url.pathname} />
      </div>

      <p class="text-xs text-muted mt-6 max-w-3xl mx-auto px-4 sm:px-6">
        Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    </article>
  </section>

  <script>
    function enhanceArticle() {
      const article = document.getElementById('article-content');
      if (!article) return;

      const calloutMap: Record<string, string> = {
        'the short version': 'callout-info',
        'key takeaway': 'callout-info',
        'bottom line': 'callout-info',
        'note': 'callout-info',
        'reality check': 'callout-warning',
        'warning': 'callout-warning',
        'important': 'callout-warning',
        'watch out': 'callout-warning',
        'pro tip': 'callout-success',
        'tip': 'callout-success',
        'quick answer': 'callout-success',
        'danger': 'callout-danger',
        'red flag': 'callout-danger',
        'caution': 'callout-danger',
      };

      article.querySelectorAll('blockquote').forEach((bq) => {
        const strong = bq.querySelector('strong');
        if (!strong) return;
        const text = strong.textContent?.replace(/[:\u2014]/g, '').trim().toLowerCase() || '';
        for (const [prefix, cls] of Object.entries(calloutMap)) {
          if (text.startsWith(prefix)) {
            bq.classList.add('callout', cls);
            break;
          }
        }
      });

      article.querySelectorAll('table').forEach((table) => {
        if (table.parentElement?.classList.contains('table-wrap')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'table-wrap';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });
    }
    enhanceArticle();
    document.addEventListener('astro:page-load', enhanceArticle);
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</PageLayout>
