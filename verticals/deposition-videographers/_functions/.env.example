# ============================================================
# Directory Factory — Cloudflare Pages Environment Variables
# Copy to your CF Pages project settings or wrangler.toml [vars]
# ============================================================

# D1 database binding (configured in wrangler.toml, not here)
# LEADS_DB = bound via wrangler.toml

# R2 bucket for photo uploads (configured in wrangler.toml)
# PHOTOS = bound via wrangler.toml

# --- Site Identity (REQUIRED — change for each vertical) ---
SITE_DOMAIN=depohire.com
SITE_NAME=DepoHire
SITE_TAGLINE=Find certified deposition videographers
SITE_FROM_EMAIL=DepoHire <noreply@depohire.com>
COMPANY_ADDRESS=PO Box 1547, Austin, TX 78767

# --- Listmonk Email (REQUIRED for email features) ---
LISTMONK_URL=https://mail.firestick.io
LISTMONK_USER=admin
LISTMONK_PASS=
LISTMONK_LIST_ID=6
LISTMONK_MAGICLINK_TEMPLATE_ID=6
LISTMONK_GUIDE_TEMPLATE_ID=7
LISTMONK_PASSTHROUGH_TEMPLATE_ID=8

# --- Security ---
TURNSTILE_SECRET_KEY=
HASH_SALT=depohire-salt-2026

# --- Stripe Payments (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio Phone Verification (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Admin ---
ADMIN_EMAIL=
