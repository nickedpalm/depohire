# Required: D1 database binding (configured in wrangler.toml, not here)
# LEADS_DB = bound via wrangler.toml

# Required: Listmonk transactional email
LISTMONK_URL=https://mail.firestick.io
LISTMONK_USER=admin
LISTMONK_PASS=

# Optional: R2 bucket for photo uploads (configured in wrangler.toml)
# PHOTOS = bound via wrangler.toml

# Optional: Stripe for Featured subscriptions
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Site branding (defaults to DepoHire values)
SITE_DOMAIN=depohire.com
SITE_NAME=DepoHire
SITE_TAGLINE=Find certified deposition videographers
SITE_FROM_EMAIL=DepoHire <noreply@depohire.com>
