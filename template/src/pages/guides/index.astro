---
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/directory/Breadcrumbs.astro';
import config from '~/config';
import guides from '~/data/guides.json';

const categoryColors: Record<string, { bg: string; text: string }> = {
  Pricing: { bg: 'bg-emerald-50', text: 'text-emerald-700' },
  'How-To': { bg: 'bg-blue-50', text: 'text-blue-700' },
  Hiring: { bg: 'bg-rose-50', text: 'text-rose-700' },
};

const metadata = {
  title: `Free Guides for Litigation Attorneys | ${config.brandName}`,
  description: 'Download free guides on deposition videographer pricing, remote deposition setup, and CLVS verification. Built for litigation teams.',
};
---
<PageLayout metadata={metadata}>
  <Fragment slot="announcement"><span></span></Fragment>

  <!-- Hero Section -->
  <div class="hero-gradient text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16">
      <Breadcrumbs crumbs={[{ label: 'Free Guides' }]} dark />
      <div class="mt-6">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">
          Free Guides for<br class="hidden sm:block" /> Litigation Attorneys
        </h1>
        <p class="mt-4 text-lg text-blue-100 max-w-2xl leading-relaxed">
          Practical, data-driven guides on hiring deposition videographers, managing costs,
          and ensuring quality. Download instantly — no strings attached.
        </p>
        <div class="mt-6 flex items-center gap-6 text-sm text-blue-200">
          <span>{guides.length} guides</span>
          <span class="w-1 h-1 rounded-full bg-blue-400"></span>
          <span>Updated {new Date().getFullYear()}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Guide Cards -->
    <div class="relative -mt-8 mb-16">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {guides.map((guide) => {
          const colors = categoryColors[guide.category] || { bg: 'bg-gray-50', text: 'text-gray-700' };
          return (
            <a href={`/guides/${guide.slug}/`}
               class="block bg-white rounded-2xl border border-gray-200 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all no-underline group overflow-hidden">
              <div class="p-6">
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${colors.bg} ${colors.text} mb-3`}>
                  {guide.category}
                </span>
                <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors leading-snug mb-2">
                  {guide.title}
                </h2>
                <p class="text-sm text-gray-500 leading-relaxed mb-4">
                  {guide.subtitle}
                </p>
                <span class="inline-flex items-center text-sm text-blue-600 font-semibold group-hover:gap-2 transition-all">
                  Download Free Guide <span class="ml-1 transition-transform group-hover:translate-x-1">&rarr;</span>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Trust Section -->
    <div class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-4">Trusted by litigation teams nationwide</p>
      <div class="flex justify-center gap-8 flex-wrap text-gray-400 text-sm">
        <div class="flex items-center gap-2">
          <span class="text-2xl">&#128220;</span>
          <span>{guides.length} free guides</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">&#9989;</span>
          <span>Real provider data</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">&#128197;</span>
          <span>Updated for {new Date().getFullYear()}</span>
        </div>
      </div>
    </div>

    <!-- Provider CTA -->
    <div class="mb-16">
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-8 sm:p-10 text-center">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">Are You a Deposition Videographer?</h2>
        <p class="text-gray-600 mb-6 max-w-lg mx-auto">
          Claim your free listing on {config.brandName} and start receiving quote requests from attorneys in your area.
        </p>
        <a href="/provider/login/"
           class="inline-flex items-center px-6 py-3 bg-[#1e3a5f] text-white font-semibold rounded-lg hover:bg-[#2a4a6b] transition-colors">
          Claim Your Listing &rarr;
        </a>
      </div>
    </div>

  </div>
</PageLayout>
